
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة التحقق من هوية المدير الرئيسي - تم التحديث لضمان الدقة
    function isOwner() {
      return request.auth != null && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == 'cybenode.site@gmail.com';
    }

    // 1. القراءة العامة لكافة سجلات الطلاب (الحضور، المدفوعات، الامتحانات، والبيانات)
    match /{path=**}/students/{id} { allow read: if true; }
    match /{path=**}/attendance/{id} { allow read: if true; }
    match /{path=**}/payments/{id} { allow read: if true; }
    match /{path=**}/exams/{id} { allow read: if true; }

    // 2. قواعد المستخدمين (المعلمين)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isOwner());
      
      match /{allSub=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isOwner());
      }
    }

    // 3. المجموعات العامة والأنظمة المركزية
    match /appConfig/{id} { 
      allow read: if true; 
      allow write: if isOwner(); 
    }
    
    match /contactMessages/{id} { 
      allow create: if true; 
      allow read, write: if isOwner(); 
    }

    match /deletionRequests/{id} { 
      allow read, write: if request.auth != null && (request.auth.uid == id || isOwner()); 
    }

    match /reviews/{id} { 
      allow read: if true; 
      allow create: if request.auth != null; 
      allow delete: if isOwner(); 
    }

    match /reviewPermissions/{id} { 
      allow read, write: if request.auth != null; 
    }

    // 4. نظام الأكواد الترويجية (Admin Only for List/Write)
    // تم تحسين القواعد لضمان قدرة المدير على جلب القائمة بالكامل
    match /promoCodes/{codeId} {
      // المدير فقط يمكنه رؤية القائمة بالكامل أو التعديل
      allow list, write: if isOwner();
      // المستخدم العادي يمكنه جلب كود واحد فقط للتحقق من صلاحيته وتفعيله
      allow get: if request.auth != null;
    }

    // تعليق لإجبار السيرفر على تحديث القواعد الآن: CybeNode Security Protocol v2.1
  }
}
