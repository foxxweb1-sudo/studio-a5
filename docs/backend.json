
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user (Teacher) of the application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "isBlocked": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "isAdFree": { "type": "boolean" },
        "adFreeActivatedAt": { "type": "string", "format": "date-time" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "paymentTiming": { "type": "string", "enum": ["start", "mid", "end"] },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "PromoCode": {
      "title": "PromoCode",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "isUsed": { "type": "boolean" },
        "usedBy": { "type": "string" },
        "usedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Student": { 
      "title": "Student", 
      "type": "object", 
      "properties": { 
        "name": { "type": "string" }, 
        "grade": { "type": "string" }, 
        "groupId": { "type": "string" },
        "parentPhone": { "type": "string" },
        "isArchived": { "type": "boolean" } 
      } 
    },
    "AttendanceRecord": { 
      "title": "AttendanceRecord", 
      "type": "object", 
      "properties": { 
        "studentId": { "type": "string" }, 
        "status": { "type": "string", "enum": ["present", "absent"] }, 
        "date": { "type": "string" } 
      } 
    },
    "Payment": { 
      "title": "Payment", 
      "type": "object", 
      "properties": { 
        "studentId": { "type": "string" }, 
        "amount": { "type": "number" }, 
        "month": { "type": "string" } 
      } 
    },
    "ExamResult": { 
      "title": "ExamResult", 
      "type": "object", 
      "properties": { 
        "studentId": { "type": "string" }, 
        "score": { "type": "number" }, 
        "totalScore": { "type": "number" }, 
        "date": { "type": "string" } 
      } 
    }
  },
  "auth": { "providers": ["password", "google.com"] },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "Teacher profile" },
    "/promoCodes/{codeId}": { "schema": { "$ref": "#/entities/PromoCode" }, "description": "Promo codes for ad removal" },
    "/users/{userId}/students/{studentId}": { "schema": { "$ref": "#/entities/Student" }, "description": "Student records for a teacher" },
    "/users/{userId}/attendance/{id}": { "schema": { "$ref": "#/entities/AttendanceRecord" }, "description": "Attendance logs" },
    "/users/{userId}/payments/{id}": { "schema": { "$ref": "#/entities/Payment" }, "description": "Payment logs" },
    "/users/{userId}/exams/{id}": { "schema": { "$ref": "#/entities/ExamResult" }, "description": "Exam results" }
  }
}
