
{
  "rules": {
    "users": {
      "$userId": {
        // المستخدم يمكنه رؤية حالته والمديرين يمكنهم رؤية الجميع
        ".read": "auth != null && (auth.uid === $userId || auth.token.email === 'cybenode.site@gmail.com' || auth.token.email === 'support.cybenode.site@gmail.com')",
        // المستخدم يمكنه تحديث بياناته والمديرين يمكنهم التعديل أيضاً
        ".write": "auth != null && (auth.uid === $userId || auth.token.email === 'cybenode.site@gmail.com' || auth.token.email === 'support.cybenode.site@gmail.com')"
      }
    },
    "portal": {
      // القراءة العامة لتقارير الطلاب (بوابة الأهل)
      ".read": "true",
      "$teacherId": {
        // المعلم والمديرين فقط يمكنهم تحديث بيانات البوابة
        ".write": "auth != null && (auth.uid === $teacherId || auth.token.email === 'cybenode.site@gmail.com' || auth.token.email === 'support.cybenode.site@gmail.com')"
      }
    }
  }
}
