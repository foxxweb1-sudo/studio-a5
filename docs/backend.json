
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a teacher in the CybeNode system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "paymentTiming": { "type": "string", "enum": ["start", "mid", "end"] },
        "isBlocked": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "isAdFree": { "type": "boolean" },
        "adFreeActivatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "PromoCode": {
      "title": "PromoCode (Realtime DB)",
      "description": "Unique codes to remove ads, managed in RTDB for performance.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "isUsed": { "type": "boolean" },
        "usedBy": { "type": "string" },
        "usedAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["code"]
    },
    "Student": {
      "title": "Student",
      "description": "A student record under a specific teacher.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "groupId": { "type": "string" },
        "parentPhone": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": { "providers": ["password", "google.com"] },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "Teacher profiles" },
    "/appConfig/global": { "schema": "object", "description": "Global settings" },
    "/deletionRequests/{id}": { "schema": "object", "description": "Account deletions" },
    "/reviews/{id}": { "schema": "object", "description": "App reviews" },
    "/users/{userId}/students/{studentId}": { "schema": { "$ref": "#/entities/Student" }, "description": "Students" },
    "/users/{userId}/attendance/{id}": { "schema": "object", "description": "Attendance logs" },
    "/users/{userId}/payments/{id}": { "schema": "object", "description": "Payments" },
    "/users/{userId}/exams/{id}": { "schema": "object", "description": "Exam scores" }
  },
  "realtime_database": {
    "/promoCodes/{code}": { "schema": { "$ref": "#/entities/PromoCode" }, "description": "Ad-free codes" },
    "/portal/{teacherId}/{studentId}": { "schema": "object", "description": "Parent portal data" },
    "/users/{userId}/isAdFree": { "type": "boolean", "description": "Real-time ad status" }
  }
}
