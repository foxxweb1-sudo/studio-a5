{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a teacher or assistant in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "isAssistant": { "type": "boolean" },
        "assignedTeacherId": { "type": "string", "description": "The UID of the teacher this assistant manages." },
        "isBlocked": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "assistantExpiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    }
  },
  "auth": { "providers": ["password", "google.com"] },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "User profiles" }
  }
}