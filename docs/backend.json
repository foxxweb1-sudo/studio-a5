
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a teacher in the CybeNode system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "paymentTiming": { "type": "string", "enum": ["start", "mid", "end"] },
        "isBlocked": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "isAdFree": { "type": "boolean" },
        "adFreeActivatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "Unique codes to remove ads for teachers.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "isUsed": { "type": "boolean" },
        "usedBy": { "type": "string" },
        "usedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code"]
    },
    "Student": {
      "title": "Student",
      "description": "A student record under a specific teacher.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "groupId": { "type": "string" },
        "parentPhone": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Student attendance entry.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial record for a student.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "month": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Exam": {
      "title": "Exam",
      "description": "Student exam result.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "score": { "type": "number" },
        "totalScore": { "type": "number" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": { "providers": ["password", "google.com"] },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "Teacher profiles" },
    "/promoCodes/{codeId}": { "schema": { "$ref": "#/entities/PromoCode" }, "description": "Ad-free codes" },
    "/appConfig/{id}": { "schema": "object", "description": "Global settings" },
    "/deletionRequests/{id}": { "schema": "object", "description": "Account deletions" },
    "/reviews/{id}": { "schema": "object", "description": "App reviews" },
    "/users/{userId}/students/{studentId}": { "schema": { "$ref": "#/entities/Student" }, "description": "Students" },
    "/users/{userId}/attendance/{id}": { "schema": { "$ref": "#/entities/Attendance" }, "description": "Attendance logs" },
    "/users/{userId}/payments/{id}": { "schema": { "$ref": "#/entities/Payment" }, "description": "Payments" },
    "/users/{userId}/exams/{id}": { "schema": { "$ref": "#/entities/Exam" }, "description": "Exam scores" }
  }
}
