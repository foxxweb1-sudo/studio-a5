
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'cybenode.site@gmail.com';
    }

    function isAssistantOf(teacherId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && 
             userDoc.isAssistant == true && 
             userDoc.assignedTeacherId == teacherId;
    }

    // 1. قواعد المستخدمين والمعلمين
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isOwner());
      
      match /{allSub=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAssistantOf(userId) || isOwner());
      }
    }

    // السماح للمدير بقراءة كافة المجموعات الفرعية (Collection Groups) للإحصائيات
    match /{path=**}/students/{id} { allow read: if isOwner(); }
    match /{path=**}/attendance/{id} { allow read: if isOwner(); }
    match /{path=**}/payments/{id} { allow read: if isOwner(); }
    match /{path=**}/exams/{id} { allow read: if isOwner(); }

    // 2. الأكواد الترويجية
    match /promoCodes/{id} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    match /appConfig/{id} { allow read: if true; allow write: if isOwner(); }
    match /deletionRequests/{id} { allow read, write: if request.auth != null && (request.auth.uid == id || isOwner()); }
    match /reviewPermissions/{id} { allow read: if request.auth != null && request.auth.uid == id; allow write: if isOwner(); }
    match /reviews/{id} { allow read: if true; allow write: if request.auth != null; }
  }
}
