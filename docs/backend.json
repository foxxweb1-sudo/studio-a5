
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a teacher in the CybeNode system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "paymentTiming": { "type": "string", "enum": ["start", "mid", "end"] },
        "isBlocked": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "isAdFree": { "type": "boolean" },
        "adFreeActivatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "Unique codes to remove ads for teachers.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "isUsed": { "type": "boolean" },
        "usedBy": { "type": "string" },
        "usedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code"]
    }
  },
  "auth": { "providers": ["password", "google.com"] },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "Teacher profiles" },
    "/promoCodes/{codeId}": { "schema": { "$ref": "#/entities/PromoCode" }, "description": "Ad-free activation codes" },
    "/appConfig/{id}": { "schema": "object", "description": "Central app settings" },
    "/deletionRequests/{id}": { "schema": "object", "description": "Account deletion queue" },
    "/reviews/{id}": { "schema": "object", "description": "User app ratings" },
    "/users/{userId}/students/{studentId}": { "schema": "object", "description": "Student records" },
    "/users/{userId}/attendance/{id}": { "schema": "object", "description": "Attendance logs" },
    "/users/{userId}/payments/{id}": { "schema": "object", "description": "Payment logs" },
    "/users/{userId}/exams/{id}": { "schema": "object", "description": "Academic scores" }
  }
}
