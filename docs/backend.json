{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a teacher in the CybeNode system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "paymentTiming": { "type": "string", "enum": ["start", "mid", "end"] },
        "isBlocked": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "isAdFree": { "type": "boolean" },
        "adFreeActivatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "GlobalConfig": {
        "title": "GlobalConfig",
        "description": "System-wide settings and ad management.",
        "type": "object",
        "properties": {
            "appName": { "type": "string" },
            "appLogo": { "type": "string" },
            "appVersion": { "type": "string" },
            "banner728x90Code": { "type": "string" },
            "banner300x250Code": { "type": "string" },
            "popunderAdCode": { "type": "string" },
            "nativeAdCode": { "type": "string" },
            "socialBarCode": { "type": "string" },
            "smartlinkCode": { "type": "string" },
            "adsenseClientCode": { "type": "string" }
        }
    }
  },
  "auth": { "providers": ["password", "google.com"] },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "Teacher profiles" },
    "/appConfig/global": { "schema": { "$ref": "#/entities/GlobalConfig" }, "description": "Global settings" }
  }
}
